# Template for .env — copy to .env and fill in. NEVER commit the real file.
#
#   cp .env.example .env
#   chmod 600 .env
#   $EDITOR .env
#   set -a; . ./.env; set +a
#
# run-daily.sh sources .env itself. Do not put these in ~/.bashrc: Ubuntu's
# .bashrc returns early for non-interactive shells, so cron would never see them
# and the nightly run would skip stages while looking healthy.

# ---- Anthropic ------------------------------------------------------------
# Used by filter.js (scoring, Haiku 4.5) and lib/answer-writer.js (narrative
# application answers and cover letters, Sonnet 5). Nothing else calls the API.
export ANTHROPIC_API_KEY=sk-ant-...

# ---- Discord ---------------------------------------------------------------
# JOBAGENT_WEBHOOK_URL is the fallback every channel falls back to when unset,
# and is the only required one. A webhook is bound to a single channel and
# cannot create channels — make the channels by hand first.
export JOBAGENT_WEBHOOK_URL=https://discord.com/api/webhooks/...
export JOBAGENT_WEBHOOK_DISCOVERIES=
export JOBAGENT_WEBHOOK_SHORTLIST=
export JOBAGENT_WEBHOOK_REVIEW=
export JOBAGENT_WEBHOOK_ERRORS=
export JOBAGENT_WEBHOOK_INTERVIEW=
export JOBAGENT_WEBHOOK_REJECTED=

# ---- Google ----------------------------------------------------------------
# Drive and Sheets authenticate DIFFERENTLY, on purpose:
#   * Drive uploads run as YOU, via ./gcloud-login.sh (application-default
#     login). A service account has no storage quota on a personal Google
#     account and cannot own a file outside a Workspace Shared Drive.
#   * Sheets uses the service-account key below. Editing an existing sheet
#     creates no file, so no quota is involved — but the sheet must be shared
#     with the service-account address as Editor.
export GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Created BY THIS APP: node drive-upload.js --init. The drive.file scope is a
# per-application grant, so a folder made through any other client is invisible
# here even when the same user owns it.
export GDRIVE_FOLDER_ID=

# The tracking spreadsheet, inside that folder. Shared with the service account.
export GSHEET_ID=

# ---- Optional: everything below has a working default ----------------------
# export PGDATABASE=jobagent
# export GOOGLE_CLOUD_PROJECT=          # ADC quota project, if not inferred
# export GDRIVE_FOLDER_NAME="Job Applications (jobagent)"
# export GSHEET_TAB=                    # defaults to the first tab
# export MASTER_FACTS=master-facts.json
# export BUILD_DIR=./build
# export ANSWER_MODEL=claude-sonnet-5   # narrative answers and cover letters
# export NO_GENERATED_ANSWERS=1         # disable narrative answers entirely
#
# run-daily.sh caps (defaults shown):
# export MAX_FILTER=100                 # jobs scored per run — caps spend
# export MAX_GENERATE=10
# export MAX_PREFILL=5
# export AUTO_SUBMIT=0                  # 1 = send what the audit fully clears
